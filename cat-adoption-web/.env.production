# IMPORTANT: This file documents environment variables needed for Vercel deployment
# These values must be set in Vercel's dashboard, NOT in this file

# Set this in Vercel Dashboard > Settings > Environment Variables
# VITE_API_URL=https://cat-adoption-net-production.up.railway.app

# For local production build testing:
# VITE_API_URL=https://cat-adoption-net-production.up.railway.app npm run build

